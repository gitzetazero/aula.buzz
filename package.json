{
  "name": "aula.buzz",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./apps/*\" build && tsx scripts/assemble.ts",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "e2e": "playwright test",
    "publish-resource": "tsx scripts/publish.ts",
    "dev": "pnpm build && wrangler dev --config wrangler.dev.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply aula --local --config wrangler.dev.jsonc",
    "db:migrate": "wrangler d1 migrations apply aula --remote",
    "release": "pnpm build && wrangler deploy"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.152.0",
    "@aula/db": "workspace:*"
  }
}
