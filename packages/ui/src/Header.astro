---
import { LOGOUT_URL, PORTAL_URL, SECTIONS } from "./sites.ts";

interface Props {
  current?: string;
}
const { current } = Astro.props;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={PORTAL_URL}>aula<span>.buzz</span></a>
    <nav class="site-nav" aria-label="Secciones">
      {
        SECTIONS.filter((s) => s.url).map((s) => (
          <a href={s.url} aria-current={s.id === current ? "page" : undefined}>
            {s.nombre}
          </a>
        ))
      }
    </nav>
    <div class="session" data-session hidden>
      <span class="session__email" data-session-email></span>
      <a class="session__logout" href={LOGOUT_URL}>Cerrar sesión</a>
    </div>
  </div>
</header>

<script>
  // Cada app expone /api/me con el mismo handler de @aula/auth.
  fetch("/api/me", { credentials: "same-origin" })
    .then((r) => (r.ok ? r.json() : null))
    .then((user: { email: string } | null) => {
      if (!user) return;
      const box = document.querySelector<HTMLElement>("[data-session]");
      const email = document.querySelector<HTMLElement>("[data-session-email]");
      if (box && email) {
        email.textContent = user.email;
        box.hidden = false;
      }
    })
    .catch(() => {});
</script>
