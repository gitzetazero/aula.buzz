---
import Layout from "@aula/ui/Layout.astro";
import { marked } from "marked";
import { loadCatalog } from "../lib/catalog.ts";
import { formatBytes } from "../lib/format.ts";
import { TIPO_LABEL, type Resource } from "../lib/schema.ts";
import Dock from "../components/downloader/Dock.tsx";
import DownloadButton from "../components/downloader/DownloadButton.tsx";
import "../styles/recursos.css";

export function getStaticPaths() {
  return loadCatalog().map((r) => ({ params: { id: r.id }, props: { r } }));
}
const { r } = Astro.props as { r: Resource };
// El contenido del catálogo lo revisan los mantenedores mediante pull request.
const instrucciones = r.instrucciones ? await marked.parse(r.instrucciones) : null;
const req = r.requisitos;
---

<Layout title={r.nombre} current="recursos" description={r.descripcion}>
  <p><a href="/">← Todos los recursos</a></p>
  <div class="layout">
    <article>
      <div class="resource__meta">
        <span class="badge">{TIPO_LABEL[r.tipo]}</span>
        <span class="muted">{r.asignatura}</span>
      </div>
      <h1>{r.nombre}</h1>
      <p>{r.descripcion}</p>

      <div class="card">
        <DownloadButton
          client:load
          resource={{ id: r.id, nombre: r.nombre, archivo: r.archivo, partes: r.partes.map((p) => ({ size: p.tamano, sha256: p.sha256 })) }}
          directUrl={r.partes.length === 1 && r.partes[0]!.github_asset_id ? `/api/gh/${r.partes[0]!.github_asset_id}` : undefined}
        />
      </div>

      <h2>Ficha</h2>
      <dl class="facts">
        <dt>Archivo</dt><dd><code>{r.archivo.nombre}</code> · {formatBytes(r.archivo.tamano)}</dd>
        {r.so && <><dt>Sistema operativo</dt><dd>{r.so}</dd></>}
        {r.hipervisor && <><dt>Hipervisor</dt><dd>{r.hipervisor}</dd></>}
        {req?.ram_gb && <><dt>RAM</dt><dd>{req.ram_gb} GB</dd></>}
        {req?.cpus && <><dt>CPUs</dt><dd>{req.cpus}</dd></>}
        {req?.disco_gb && <><dt>Disco</dt><dd>{req.disco_gb} GB</dd></>}
        <dt>Actualizado</dt><dd>{r.actualizado.toLocaleDateString("es-ES", { dateStyle: "long" })}</dd>
        <dt>SHA-256</dt><dd><code class="hash">{r.archivo.sha256}</code></dd>
      </dl>

      {
        r.credenciales.length > 0 && (
          <>
            <h2>Credenciales por defecto</h2>
            <ul>
              {r.credenciales.map((c) => (
                <li>
                  Usuario <code>{c.usuario}</code> · contraseña <code>{c.password}</code>
                  {c.nota && <span class="muted"> — {c.nota}</span>}
                </li>
              ))}
            </ul>
          </>
        )
      }
      {instrucciones && <><h2>Instrucciones</h2><div class="prose" set:html={instrucciones} /></>}
    </article>
    <Dock client:load />
  </div>
</Layout>
