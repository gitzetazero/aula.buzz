{
  "extends": "astro/tsconfigs/strict",
  "include": ["./**/*.ts", "../src/generated/catalog.json"],
  "exclude": ["./**/*.test.ts"],
  "compilerOptions": {
    "types": ["@cloudflare/workers-types"],
    "lib": ["ES2022"],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true
  }
}
