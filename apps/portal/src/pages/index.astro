---
import Layout from "@aula/ui/Layout.astro";
import { SECTIONS } from "@aula/ui/sites";
---

<Layout title="aula.buzz" current="portal">
  <h1>Bienvenido a aula.buzz</h1>
  <p class="muted">Todo lo que necesitamos en clase, en un solo sitio.</p>
  <div class="grid" data-sections>
    {
      SECTIONS.map((s) =>
        s.url ? (
          <a class="card section" href={s.url}>
            <h2>{s.nombre}</h2>
            <p class="muted">{s.descripcion}</p>
          </a>
        ) : (
          <div class="card section section--soon" aria-disabled="true">
            <h2>{s.nombre}</h2>
            <p class="muted">{s.descripcion}</p>
          </div>
        ),
      )
    }
  </div>
</Layout>

<script>
  // Las secciones visibles las decide el panel de administración.
  interface Section {
    nombre: string;
    descripcion: string;
    url?: string;
  }
  const w = window as unknown as { aulaSettings?: Promise<{ sections: Section[] } | null> };
  w.aulaSettings?.then((settings) => {
    const grid = document.querySelector<HTMLElement>("[data-sections]");
    if (!settings || !grid) return;
    grid.replaceChildren(
      ...settings.sections.map((s) => {
        const el = document.createElement(s.url ? "a" : "div");
        el.className = s.url ? "card section" : "card section section--soon";
        if (s.url) (el as HTMLAnchorElement).href = s.url;
        else el.setAttribute("aria-disabled", "true");
        const h = document.createElement("h2");
        h.textContent = s.nombre;
        const p = document.createElement("p");
        p.className = "muted";
        p.textContent = s.descripcion;
        el.append(h, p);
        return el;
      }),
    );
  });
</script>

<style is:global>
  .grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    margin-top: 1.5rem;
  }
  .section {
    text-decoration: none;
    color: inherit;
  }
  a.section:hover {
    border-color: var(--accent);
  }
  .section--soon {
    opacity: 0.6;
  }
  .section p {
    margin: 0;
  }
</style>
