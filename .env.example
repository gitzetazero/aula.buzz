# Variables y secretos del Worker. En producción se ponen con
# `pnpm exec wrangler secret put NOMBRE` (nunca en el repo).
# En local, copia este archivo a .dev.vars

# Cloudflare Access (Zero Trust → Settings → Custom pages / Applications)
ACCESS_TEAM_DOMAIN=tu-equipo.cloudflareaccess.com
ACCESS_AUD=

# Solo desarrollo local: usuario simulado cuando la petición llega a localhost.
# AUTH_DEV_EMAIL=yo@ejemplo.com

# Descargas: token fine-grained de GitHub con "Contents: Read" sobre el repo privado.
GH_ASSETS_TOKEN=
GH_ASSETS_REPO=gitzetazero/aulareleases

# JSON completo de la clave de la service account de Google (en una línea).
GDRIVE_SA_JSON=

# Panel de admin (opcionales)
# Subida/borrado en GitHub: token con "Contents: Write".
GH_UPLOAD_TOKEN=
# Carpeta de Drive donde sube el panel (compartida con la service account como Editor).
GDRIVE_FOLDER_ID=
# Sincronizar usuarios con la política de Access.
CF_API_TOKEN=
CF_ACCOUNT_ID=
ACCESS_APP_ID=
ACCESS_POLICY_ID=

# Administrador principal: no se le puede quitar el rol, desactivar ni borrar.
OWNER_EMAIL=
