# Variables de las Pages Functions. En producción se configuran en
# Cloudflare Pages → Settings → Variables and Secrets (nunca en el repo).
# En local, copia este archivo a apps/<app>/.dev.vars

# Cloudflare Access (Zero Trust → Settings → Custom pages / Applications)
ACCESS_TEAM_DOMAIN=tu-equipo.cloudflareaccess.com
ACCESS_AUD=

# Solo desarrollo local: usuario simulado cuando la petición llega a localhost.
# AUTH_DEV_EMAIL=yo@ejemplo.com

# --- Solo recursos.aula.buzz ---
# Token fine-grained de GitHub con permiso "Contents: Read" sobre el repo privado.
GH_ASSETS_TOKEN=
GH_ASSETS_REPO=usuario/aula-recursos

# JSON completo de la clave de la service account de Google (en una línea).
GDRIVE_SA_JSON=
